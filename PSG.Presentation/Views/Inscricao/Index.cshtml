@* Helpers: traduzem o EnumStatus em texto e em classes Tailwind (badge/linha) *@
@functions {
    string StatusText(EnumStatus status) => status switch
    {
        EnumStatus.Aprovado => "Aprovado",
        EnumStatus.Reprovado => "Reprovado",
        EnumStatus.EmAndamento => "Andamento",
        EnumStatus.Cancelado => "Cancelado",
        _ => status.ToString()
    };

    string StatusClass(EnumStatus status) => status switch
    {
        EnumStatus.Aprovado => "bg-green-100 text-green-700",
        EnumStatus.Reprovado => "bg-red-100 text-red-600",
        EnumStatus.EmAndamento => "bg-blue-100 text-blue-700",
        EnumStatus.Cancelado => "bg-slate-100 text-slate-500",
        _ => "bg-slate-100 text-slate-500"
    };

    string RowClass(EnumStatus status) => status switch
    {
        EnumStatus.Aprovado => "bg-green-50",
        EnumStatus.Reprovado => "bg-red-50",
        EnumStatus.EmAndamento => "bg-amber-50",
        _ => ""
    };
}

@Html.AntiForgeryToken()

@* As modais carregadas por fetch (criar e editar) são injetadas aqui *@
<div id="modalContainer"></div>

@* ===== Confirmação de exclusão =====
   Fica no HTML e só é exibida/escondida — não precisa de ida ao servidor. *@
<div id="modalExcluirInscricao" class="hidden fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/50" data-fechar-exclusao></div>

    <div class="relative bg-white rounded-2xl shadow-lg w-full max-w-md mx-4">
        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
            <h5 class="font-bold text-slate-800">Excluir inscrição</h5>
            <button type="button" data-fechar-exclusao
                    class="text-slate-400 hover:text-slate-600 text-xl leading-none">
                &times;
            </button>
        </div>

        <div class="px-5 py-5 flex items-start gap-3">
            <span class="w-10 h-10 shrink-0 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
                <i class="bi bi-exclamation-triangle text-lg"></i>
            </span>
            <div class="min-w-0">
                <p class="text-sm text-slate-700">
                    Excluir a inscrição de <span id="alunoExclusao" class="font-semibold text-slate-900"></span>
                    em <span id="moduloExclusao" class="font-semibold text-slate-900"></span>?
                </p>
                <p class="text-xs text-slate-500 mt-1">
                    A inscrição deixa de aparecer nas listagens e nos indicadores.
                    O registro é mantido no banco.
                </p>
                <p id="erroExclusaoInscricao" class="hidden bg-red-50 text-red-600 text-xs rounded-lg px-3 py-2 mt-3"></p>
            </div>
        </div>

        <div class="border-t border-slate-100 px-5 py-4 flex justify-end gap-2">
            <button type="button" data-fechar-exclusao
                    class="px-4 py-2 rounded-lg text-sm font-semibold text-slate-600 border border-slate-300 hover:bg-slate-50">
                Cancelar
            </button>
            <button type="button" id="btnConfirmarExclusaoInscricao"
                    class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition-colors">
                <i class="bi bi-trash"></i>
                Excluir
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalContainer = document.getElementById('modalContainer');

        document.getElementById('btnNovaInscricao').addEventListener('click', async () => {
            const resp = await fetch('/Inscricao/CreateModal');
            if (!resp.ok) {
                alert('Não foi possível carregar o formulário.');
                return;
            }
            modalContainer.innerHTML = await resp.text();
            document.body.classList.add('overflow-hidden'); // trava o scroll da página atrás da modal
            vincularEventosModal();
        });

        function fecharModal() {
            modalContainer.innerHTML = '';
            document.body.classList.remove('overflow-hidden');
        }

        function vincularEventosModal() {
            const selectCurso = document.getElementById('selectCursoModal');
            const selectModulo = document.getElementById('selectModuloModal');
            const form = document.getElementById('formNovaInscricao');

            document.getElementById('btnFecharModal').addEventListener('click', fecharModal);
            document.getElementById('btnCancelarModal').addEventListener('click', fecharModal);
            document.getElementById('modalBackdrop').addEventListener('click', fecharModal);

            // Fecha com ESC
            document.addEventListener('keydown', function escHandler(e) {
                if (e.key === 'Escape') {
                    fecharModal();
                    document.removeEventListener('keydown', escHandler);
                }
            });

            // Cascata Curso -> Módulo
            selectCurso.addEventListener('change', async () => {
                selectModulo.innerHTML = '<option value="">Carregando...</option>';
                selectModulo.disabled = true;

                const cursoId = selectCurso.value;
                if (!cursoId) {
                    selectModulo.innerHTML = '<option value="">Selecione o curso primeiro</option>';
                    return;
                }

                const resp = await fetch(`/Inscricao/GetModulosPorCursoModal?cursoId=${cursoId}`);
                const modulos = await resp.json();

                selectModulo.innerHTML = '<option value="">Selecione...</option>';
                modulos.forEach(m => {
                    const opt = document.createElement('option');
                    opt.value = m.value;
                    opt.textContent = m.text;
                    selectModulo.appendChild(opt);
                });
                selectModulo.disabled = false;
            });

            // Submit via AJAX
            form.addEventListener('submit', async (e) => {
                e.preventDefault();

                const erroGeral = document.getElementById('erroGeralInscricao');
                erroGeral.classList.add('hidden');

                const btnSalvar = document.getElementById('btnSalvarInscricao');
                btnSalvar.disabled = true;

                const resp = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form)
                });

                if (resp.ok) {
                    location.reload();
                    return;
                }

                if (resp.status === 400) {
                    modalContainer.innerHTML = await resp.text();
                    vincularEventosModal();
                } else {
                    erroGeral.textContent = 'Erro inesperado ao salvar. Tente novamente.';
                    erroGeral.classList.remove('hidden');
                    btnSalvar.disabled = false;
                }
            });
        }

        // ===== Cascata Curso -> Módulo no FILTRO (mesma ideia da modal) =====
        // Ao trocar o curso no filtro, busca via AJAX os módulos daquele curso e
        // preenche o dropdown de módulo, mantendo "Todos" como primeira opção.
        (function () {
            const filtroCurso = document.getElementById('CursoId');
            const filtroModulo = document.getElementById('ModuloId');
            if (!filtroCurso || !filtroModulo) return;

            filtroCurso.addEventListener('change', async () => {
                const cursoId = filtroCurso.value;

                // Sem curso selecionado: volta o módulo para "Todos"
                if (!cursoId) {
                    filtroModulo.innerHTML = '<option value="">Todos</option>';
                    return;
                }

                filtroModulo.innerHTML = '<option value="">Carregando...</option>';

                const resp = await fetch(`/Inscricao/GetModulosPorCursoModal?cursoId=${cursoId}`);
                const modulos = await resp.json();

                filtroModulo.innerHTML = '<option value="">Todos</option>';
                modulos.forEach(m => {
                    const opt = document.createElement('option');
                    opt.value = m.value;
                    opt.textContent = m.text;
                    filtroModulo.appendChild(opt);
                });
            });
        })();

        // ===== Edição da inscrição (lápis) =====
        // Mesmo esquema da modal de criação: a modal vem por fetch, o POST volta 400
        // com o formulário re-renderizado quando há erro de validação.
        const tokenAntiForgery = () =>
            document.querySelector('input[name="__RequestVerificationToken"]').value;

        document.querySelectorAll('.btn-editar-inscricao').forEach(botao => {
            botao.addEventListener('click', async () => {
                const resp = await fetch(`@Url.Action("EditarModal", "Inscricao")?idAlunoModulo=${botao.dataset.id}`);
                if (!resp.ok) {
                    alert('Não foi possível carregar a inscrição.');
                    return;
                }
                modalContainer.innerHTML = await resp.text();
                document.body.classList.add('overflow-hidden');
                vincularEventosModalEdicao();
            });
        });

        function vincularEventosModalEdicao() {
            const form = document.getElementById('formEditarInscricao');

            document.getElementById('btnFecharModalEdicao').addEventListener('click', fecharModal);
            document.getElementById('btnCancelarModalEdicao').addEventListener('click', fecharModal);
            document.getElementById('modalBackdropEdicao').addEventListener('click', fecharModal);

            // Fecha com ESC
            document.addEventListener('keydown', function escHandler(e) {
                if (e.key === 'Escape') {
                    fecharModal();
                    document.removeEventListener('keydown', escHandler);
                }
            });

            form.addEventListener('submit', async (e) => {
                e.preventDefault();

                const erroGeral = document.getElementById('erroGeralEdicao');
                erroGeral.classList.add('hidden');

                const btnSalvar = document.getElementById('btnSalvarInscricaoEdicao');
                btnSalvar.disabled = true;

                const resp = await fetch(form.action, { method: 'POST', body: new FormData(form) });

                if (resp.ok) {
                    location.reload();
                    return;
                }

                if (resp.status === 400) {
                    modalContainer.innerHTML = await resp.text();
                    vincularEventosModalEdicao();
                } else {
                    erroGeral.textContent = 'Erro inesperado ao salvar. Tente novamente.';
                    erroGeral.classList.remove('hidden');
                    btnSalvar.disabled = false;
                }
            });
        }

        // ===== Exclusão da inscrição (lixeira) =====
        const modalExcluir = document.getElementById('modalExcluirInscricao');
        const erroExclusao = document.getElementById('erroExclusaoInscricao');
        const btnConfirmarExclusao = document.getElementById('btnConfirmarExclusaoInscricao');
        let idInscricaoParaExcluir = null;

        function fecharExclusao() {
            modalExcluir.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
            idInscricaoParaExcluir = null;
        }

        document.querySelectorAll('.btn-excluir-inscricao').forEach(botao => {
            botao.addEventListener('click', () => {
                idInscricaoParaExcluir = botao.dataset.id;
                document.getElementById('alunoExclusao').textContent = botao.dataset.aluno;
                document.getElementById('moduloExclusao').textContent = botao.dataset.modulo;
                erroExclusao.classList.add('hidden');
                btnConfirmarExclusao.disabled = false;
                modalExcluir.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            });
        });

        document.querySelectorAll('[data-fechar-exclusao]').forEach(el =>
            el.addEventListener('click', fecharExclusao));

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && !modalExcluir.classList.contains('hidden')) fecharExclusao();
        });

        btnConfirmarExclusao.addEventListener('click', async () => {
            if (!idInscricaoParaExcluir) return;

            btnConfirmarExclusao.disabled = true;

            const dados = new FormData();
            dados.append('idAlunoModulo', idInscricaoParaExcluir);
            dados.append('__RequestVerificationToken', tokenAntiForgery());

            const resp = await fetch('@Url.Action("Excluir", "Inscricao")', { method: 'POST', body: dados });

            if (resp.ok) {
                location.reload();
                return;
            }

            erroExclusao.textContent = 'Não foi possível excluir a inscrição. Tente novamente.';
            erroExclusao.classList.remove('hidden');
            btnConfirmarExclusao.disabled = false;
        });
    </script>
}